# ------------------------------------------------------------------
# DataGuard-AI – Konfiguration (Vorlage)
# Kopieren nach `.env` und Werte eintragen. `.env` niemals einchecken.
# Ohne API-Key läuft das Projekt vollständig im Offline-Modus (Mock).
# Alternative zu .env (macOS): security add-generic-password -s "DataGuard-AI" -a "ANTHROPIC_API_KEY" -w
# Vorrang: Umgebungsvariable > .env > Schlüsselbund. Werte werden nie angezeigt oder protokolliert.
# ------------------------------------------------------------------

# LLM-Anbieter: mock | claude | gemini
LLM_ANBIETER=mock

# --- Anthropic Claude ---
# Aktuelle Modell-IDs: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Gemini ---
# Aktuelle Modell-IDs: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Agent-Verhalten ---
LLM_MAX_TOKENS=1024
# Leer lassen = Standard des Modells (manche Modelle akzeptieren keinen Wert)
LLM_TEMPERATUR=

# --- Optionale Online-Bestätigung der USt-IdNr. (standardmäßig AUS) ---
# Nur mit ausdrücklicher Zustimmung aktivieren: sendet USt-IdNrn. an VIES (EU-Kommission). Stand prüfen.
UST_ONLINE_PRUEFUNG=aus

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
